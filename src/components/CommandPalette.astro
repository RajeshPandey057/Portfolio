<dialog class="command-dialog" id="command-menu" aria-labelledby="command-title">
	<form method="dialog" class="command-shell">
		<div class="command-search">
			<label id="command-title" for="command-input">Go anywhere</label>
			<button value="cancel" aria-label="Close command menu">Esc</button>
		</div>
		<input
			id="command-input"
			type="search"
			placeholder="Type a page or action..."
			autocomplete="off"
			data-command-input
		/>
		<nav class="command-list" aria-label="Quick navigation" data-command-list>
			<a href="/#work" data-command-item data-keywords="work projects case studies">
				<span><small>Navigate</small>Selected work</span><kbd>W</kbd>
			</a>
			<a href="/#experience" data-command-item data-keywords="experience career jobs resume">
				<span><small>Navigate</small>Experience</span><kbd>E</kbd>
			</a>
			<a href="/blog/" data-command-item data-keywords="blog writing articles notes">
				<span><small>Navigate</small>Writing</span><kbd>N</kbd>
			</a>
			<a href="/resume.pdf" target="_blank" rel="noopener" data-command-item data-keywords="cv resume pdf">
				<span><small>Open</small>Résumé</span><kbd>R</kbd>
			</a>
			<a
				href="https://github.com/RajeshPandey057"
				target="_blank"
				rel="noopener"
				data-command-item
				data-keywords="github code source repositories"
			>
				<span><small>Open</small>GitHub</span><kbd>G</kbd>
			</a>
			<a
				href="mailto:rajesh-pandey@outlook.in?subject=Engineering%20enquiry"
				data-command-item
				data-keywords="email contact hire role consulting"
			>
				<span><small>Contact</small>Email Rajesh</span><kbd>M</kbd>
			</a>
			<button type="button" data-command-item data-command-surprise data-keywords="random surprise">
				<span><small>Try</small>Surprise me</span><kbd>?</kbd>
			</button>
		</nav>
		<p class="command-empty" data-command-empty hidden>No matching command.</p>
		<p class="command-hint">Hint: a classic cheat code works here.</p>
	</form>
</dialog>
<div class="debug-toast" role="status" aria-live="polite" data-debug-toast></div>

<script>
	const root = document.documentElement;
	const dialog = document.querySelector<HTMLDialogElement>('#command-menu');
	const input = document.querySelector<HTMLInputElement>('[data-command-input]');
	const items = Array.from(document.querySelectorAll<HTMLElement>('[data-command-item]'));
	const empty = document.querySelector<HTMLElement>('[data-command-empty]');
	const toast = document.querySelector<HTMLElement>('[data-debug-toast]');
	const surpriseRoutes = [
		'/blog/building-and-selling-a-telehealth-startup/',
		'/blog/zero-downtime-billing-migrations/',
		'/#projects',
	];

	const openCommand = () => {
		if (!dialog?.open) dialog?.showModal();
		input?.focus();
	};

	document.querySelectorAll<HTMLElement>('[data-command-open]').forEach((trigger) => {
		trigger.addEventListener('click', openCommand);
	});

	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			openCommand();
		}
	});

	input?.addEventListener('input', () => {
		const query = input.value.toLowerCase().trim();
		let visible = 0;
		items.forEach((item) => {
			const haystack = `${item.textContent} ${item.dataset.keywords ?? ''}`.toLowerCase();
			const matches = haystack.includes(query);
			item.hidden = !matches;
			if (matches) visible += 1;
		});
		if (empty) empty.hidden = visible !== 0;
	});

	document.querySelector<HTMLElement>('[data-command-surprise]')?.addEventListener('click', () => {
		const route = surpriseRoutes[Math.floor(Math.random() * surpriseRoutes.length)];
		window.location.href = route;
	});

	const konami = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
	let konamiIndex = 0;
	document.addEventListener('keydown', (event) => {
		const expected = konami[konamiIndex];
		const pressed = event.key.length === 1 ? event.key.toLowerCase() : event.key;
		konamiIndex = pressed === expected ? konamiIndex + 1 : 0;
		if (konamiIndex === konami.length) {
			root.classList.toggle('debug-mode');
			if (toast) toast.textContent = 'Debug mode unlocked. No production incidents were caused.';
			toast?.classList.add('is-visible');
			window.setTimeout(() => toast?.classList.remove('is-visible'), 3200);
			konamiIndex = 0;
		}
	});

	console.info(
		'%cYou found the console.%c Try ↑ ↑ ↓ ↓ ← → ← → B A',
		'color:#ed7952;font-weight:700;font-size:14px',
		'color:inherit',
	);
</script>
