---
import { SITE_TITLE, SOCIAL } from '../consts';
const today = new Date();
---

<footer class="site-footer">
	<div class="shell footer-grid">
		<div>
			<p class="footer-heading">Build systems people can rely on.</p>
			<a class="footer-email" href={SOCIAL.email}>rajesh-pandey@outlook.in</a>
		</div>
		<nav class="footer-links" aria-label="Footer navigation">
			<a href="/#impact">Selected work</a>
			<a href="/blog/">Writing</a>
			<a href="/resume.pdf" target="_blank" rel="noopener">Résumé</a>
			<a href={SOCIAL.github} target="_blank" rel="noopener">GitHub</a>
			<a href={SOCIAL.linkedin} target="_blank" rel="noopener">LinkedIn</a>
		</nav>
	</div>
	<div class="shell footer-meta">
		<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
		<span>Surat, Gujarat, India</span>
	</div>
</footer>
