---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import billingCover from '../assets/billing-migration-cover.png';
import portrait from '../assets/portrait-square.jpg';
import telehealthCover from '../assets/telehealth-startup-cover.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE, SOCIAL } from '../consts';
import { homePageGraph } from '../lib/seo';

const homeTitle = `${SITE_TITLE} | ${SITE_TAGLINE} for healthcare platforms`;
const schema = homePageGraph(Astro.site);

const latestPosts = (await getCollection('blog', ({ data }) => data.draft !== true))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);

const readingMinutes = (body: string) => Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 220));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={homeTitle}
			description={SITE_DESCRIPTION}
			type="profile"
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="portfolio-home">
			<section class="shell portfolio-hero">
				<div class="portfolio-intro" data-reveal data-reveal-sequence>
					<p class="hero-kicker">Rajesh Pandey <span>Lead Technical Engineer</span></p>
					<h1>Hi, I’m Rajesh.</h1>
					<p class="hero-deck">
						Lead engineer across cloud, backend, and mobile. I built a telehealth startup as a
						side project, acquired after 250K+ downloads.
					</p>
					<div class="hero-actions">
						<a class="button" href="#work">See my work</a>
						<a class="button button-secondary" href="/resume.pdf" target="_blank" rel="noopener">
							Résumé
						</a>
					</div>
				</div>

				<aside class="profile-note" aria-label="About Rajesh" data-reveal>
					<div class="profile-photo">
						<Image
							src={portrait}
							alt="Rajesh Pandey, Lead Technical Engineer"
							width={300}
							height={300}
							widths={[180, 300, 450]}
							sizes="(max-width: 760px) 8rem, 13rem"
							loading="eager"
						/>
						<span aria-hidden="true">that’s me</span>
					</div>
					<div class="profile-current">
						<p>Currently</p>
						<strong>Leading engineering across healthcare products at Allia.</strong>
					</div>
					<p class="profile-aside">
						I like the work between “it works on my machine” and “patients depend on it.”
					</p>
				</aside>
			</section>

			<section class="shell proof-strip" aria-label="Career highlights" data-reveal>
				<p><strong>8+</strong> years shipping</p>
				<p><strong>250K+</strong> Medsi downloads</p>
				<p><strong>5,000+</strong> consultations</p>
				<p><strong>7+</strong> systems integrated</p>
			</section>

			<div class="shell portfolio-layout">
				<aside class="portfolio-index" aria-label="Page sections">
					<p>On this page</p>
					<nav data-section-nav>
						<a href="#work" data-section-link>Selected work</a>
						<a href="#experience" data-section-link>Experience</a>
						<a href="#focus" data-section-link>Engineering focus</a>
						<a href="#projects" data-section-link>Side projects</a>
						<a href="#writing" data-section-link>Writing</a>
						<a href="#about" data-section-link>About</a>
					</nav>
					<button class="index-command" type="button" data-command-open>
						Quick jump <kbd>⌘ K</kbd>
					</button>
				</aside>

				<div class="portfolio-stream">
					<section id="work" class="portfolio-section work-section">
						<span id="impact" class="anchor-alias" aria-hidden="true"></span>
						<header class="portfolio-section-header" data-reveal>
							<h2>Selected engineering work</h2>
							<p>Production systems, my role in them, and what changed after the code shipped.</p>
						</header>

						<div class="work-list">
							<article class="work-entry work-entry-featured" data-reveal>
								<a
									class="work-image"
									href="/blog/building-and-selling-a-telehealth-startup/"
									aria-label="Read the Medsi engineering case study"
								>
									<Image
										src={telehealthCover}
										alt="A modular healthcare network connected to a central coral system"
										width={960}
										height={540}
										widths={[520, 800, 1200]}
										sizes="(max-width: 760px) 100vw, 44vw"
									/>
								</a>
								<div class="work-copy">
									<div class="work-heading">
										<p>Medsi</p>
										<span>Founding Engineer</span>
									</div>
									<h3>Built a telehealth platform from zero to acquisition</h3>
									<p>
										Owned the backend, APIs, mobile infrastructure, and production operations
										behind a healthcare product used across India.
									</p>
									<dl class="work-facts">
										<div>
											<dt>Built with</dt>
											<dd>Node.js, React Native, cloud infrastructure</dd>
										</div>
										<div>
											<dt>Result</dt>
											<dd>250K+ downloads, 5,000+ consultations, acquired in 2024</dd>
										</div>
										<div>
											<dt>Context</dt>
											<dd>Side project alongside a full-time role at TCS</dd>
										</div>
									</dl>
									<a class="text-link" href="/blog/building-and-selling-a-telehealth-startup/">
										Read the engineering story <span aria-hidden="true">→</span>
									</a>
								</div>
							</article>

							<article class="work-entry work-entry-migration" data-reveal>
								<div class="work-copy">
									<div class="work-heading">
										<p>Allia and Brello</p>
										<span>Technical lead</span>
									</div>
									<h3>Moved live subscription billing without interrupting patients</h3>
									<p>
										Planned and delivered the WooCommerce-to-Stripe handover: historical
										backfills, active-order linking, cohort cutovers, and reconciliation.
									</p>
									<dl class="work-facts">
										<div>
											<dt>Problem</dt>
											<dd>Change the billing system while subscriptions remained active</dd>
										</div>
										<div>
											<dt>Engineering</dt>
											<dd>Idempotent writes, checkpoints, dry runs, and rollback paths</dd>
										</div>
									</dl>
									<a class="text-link" href="/blog/zero-downtime-billing-migrations/">
										Read the migration playbook <span aria-hidden="true">→</span>
									</a>
								</div>
								<a
									class="work-image"
									href="/blog/zero-downtime-billing-migrations/"
									aria-label="Read the billing migration case study"
								>
									<Image
										src={billingCover}
										alt="Two billing systems connected by a continuous coral transfer path"
										width={960}
										height={540}
										widths={[520, 800, 1200]}
										sizes="(max-width: 760px) 100vw, 34vw"
									/>
								</a>
							</article>

							<article class="work-entry work-entry-systems" data-reveal>
								<div class="work-heading">
									<p>Real-time data hub</p>
									<span>Contributor in the wider data team</span>
								</div>
								<div class="systems-copy">
									<div>
										<h3>Connected the systems behind healthcare delivery</h3>
										<p>
											Built and operated event-driven consumers and webhook services across
											commerce, clinical care, fulfillment, support, and shipping.
										</p>
									</div>
									<ul aria-label="Systems integrated">
										<li>WooCommerce</li>
										<li>Stripe</li>
										<li>TelegraMD</li>
										<li>LifeFile</li>
										<li>EasyPost</li>
										<li>Intercom</li>
									</ul>
								</div>
								<p class="systems-stack">
									Cloud Functions / Cloud Run / Pub/Sub / TypeScript / Elasticsearch
								</p>
							</article>
						</div>
					</section>

					<section id="experience" class="portfolio-section">
						<header class="portfolio-section-header" data-reveal>
							<h2>Experience</h2>
							<p>From enterprise software to startup founder, then platform engineering leadership.</p>
						</header>

						<div class="experience-list">
							<article class="experience-item" data-reveal>
								<div class="experience-date">2025 to now</div>
								<div>
									<h3 class="experience-role">Lead Technical Engineer</h3>
									<p class="experience-company">Allia Health Group</p>
									<p class="experience-description">
										Lead delivery across patient platforms, admin tooling, Brello, and provider
										workflows.
									</p>
									<ul class="experience-points">
										<li>Build event-driven Google Cloud integrations with the data team.</li>
										<li>Lead subscription and order migration into Stripe.</li>
										<li>Ship backend and mobile features through production release workflows.</li>
									</ul>
								</div>
							</article>
							<article class="experience-item" data-reveal>
								<div class="experience-date">2024 to 2025</div>
								<div>
									<h3 class="experience-role">Lead Software Engineer and Architect</h3>
									<p class="experience-company">HelloWellness</p>
									<p class="experience-description">
										Led architecture across backend, mobile, and patient-facing systems after
										HelloWellness acquired Medsi.
									</p>
								</div>
							</article>
							<article class="experience-item" data-reveal>
								<div class="experience-date">Earlier</div>
								<div>
									<h3 class="experience-role">Founding Engineer</h3>
									<p class="experience-company">Medsi</p>
									<p class="experience-description">
										Built the core telehealth platform and its infrastructure through growth and
										acquisition, as a side project alongside a full-time engineering role at TCS.
									</p>
								</div>
							</article>
							<article class="experience-item" data-reveal>
								<div class="experience-date">Foundation</div>
								<div>
									<h3 class="experience-role">Software Engineer</h3>
									<p class="experience-company">Tata Consultancy Services</p>
									<p class="experience-description">
										Built an enterprise accounting application for high-volume workloads and
										earned TCS Wings 1 recognition.
									</p>
								</div>
							</article>
						</div>
						<a class="text-link" href="/resume.pdf" target="_blank" rel="noopener">
							Full résumé <span aria-hidden="true">↗</span>
						</a>
					</section>

					<section id="focus" class="portfolio-section focus-section">
						<header class="portfolio-section-header" data-reveal>
							<h2>Engineering focus</h2>
							<p>The parts of software delivery where I tend to be most useful.</p>
						</header>
						<div class="focus-grid" data-reveal>
							<div>
								<h3>Platform</h3>
								<p>Event-driven services, integrations, observability, and production operations.</p>
							</div>
							<div>
								<h3>Product</h3>
								<p>Backend and mobile features that cross team and system boundaries.</p>
							</div>
							<div>
								<h3>Change</h3>
								<p>Data migrations, billing handovers, cutovers, and reconciliation.</p>
							</div>
							<div>
								<h3>Leadership</h3>
								<p>Architecture, technical direction, mentoring, and coordinated delivery.</p>
							</div>
						</div>
						<p class="stack-line" data-reveal>
							<span>TypeScript</span><span>Node.js</span><span>React Native</span
							><span>Google Cloud</span><span>Cloud Run</span><span>Pub/Sub</span
							><span>Elasticsearch</span><span>Stripe</span><span>CI/CD</span>
						</p>
					</section>

					<section id="projects" class="portfolio-section">
						<header class="portfolio-section-header" data-reveal>
							<h2>Things I build for fun</h2>
							<p>Small products are where I try ideas before they become work.</p>
						</header>
						<div class="project-list">
							<a
								class="project"
								href="https://polygram.dev/"
								target="_blank"
								rel="noopener"
								data-reveal
							>
								<div>
									<p class="project-state">Building with friends</p>
									<h3>Polygram</h3>
									<p>
										An AI-native coding and design workspace with a VS Code extension, visual
										canvas, and chat-driven development.
									</p>
								</div>
								<div class="project-meta">TypeScript / developer tooling / AI agents ↗</div>
							</a>
							<a
								class="project"
								href="https://chromewebstore.google.com/detail/imageconverter/kpgidifiophnbmnhacklginlcfbbdbld"
								target="_blank"
								rel="noopener"
								data-reveal
							>
								<div>
									<p class="project-state">Shipped</p>
									<h3>Image Converter</h3>
									<p>
										A privacy-first Chrome extension that converts images locally in the
										browser. No uploads, no waiting.
									</p>
								</div>
								<div class="project-meta">Chrome extension / offline / 5.0 rating ↗</div>
							</a>
							<a
								class="project"
								href="https://github.com/RajeshPandey057/orderhive"
								target="_blank"
								rel="noopener"
								data-reveal
							>
								<div>
									<p class="project-state">Shipped</p>
									<h3>OrderHive</h3>
									<p>
										An end-to-end sales operations platform for a real estate brokerage — deal
										tracking, DocuSign e-signatures, and compliance/finance review workflows.
									</p>
								</div>
								<div class="project-meta">SvelteKit / Firebase / DocuSign ↗</div>
							</a>
						</div>
					</section>

					<section id="writing" class="portfolio-section">
						<header class="portfolio-section-header" data-reveal>
							<h2>Writing</h2>
							<p>Notes from production, with the useful details left in.</p>
						</header>
						<div class="home-writing-list">
							{
								latestPosts.map((post) => {
									const hero = post.data.heroImage;
									return (
										<a class="home-writing-row" href={`/blog/${post.id}/`} data-reveal>
											{hero && (
												<Image
													src={hero}
													alt={post.data.heroImageAlt ?? ''}
													width={320}
													height={180}
													widths={[240, 320, 480]}
													sizes="(max-width: 680px) 100vw, 10rem"
												/>
											)}
											<div>
												<h3>{post.data.title}</h3>
												<p>{post.data.description}</p>
												<div class="writing-meta">
													<FormattedDate date={post.data.pubDate} />
													<span>{readingMinutes(post.body ?? '')} min read</span>
													<span>{post.data.tags.slice(0, 2).join(' / ')}</span>
												</div>
											</div>
											<span class="writing-arrow" aria-hidden="true">→</span>
										</a>
									);
								})
							}
						</div>
						<a class="text-link" href="/blog/">
							All writing <span aria-hidden="true">→</span>
						</a>
					</section>

					<section id="about" class="portfolio-section about-section">
						<div class="about-statement" data-reveal>
							<p>
								I gravitate to the messy parts: migrations, data backfills, billing handovers,
								integration failures, and the production work that earns user trust.
							</p>
						</div>
						<div class="about-details" data-reveal>
							<h2>A little more about me</h2>
							<p>
								I work across backend, frontend, mobile, DevOps, and product. That breadth helps
								me spot the seams where systems usually fail.
							</p>
							<p>
								Beyond engineering, my leadership foundation includes NCC Alpha grade, the
								Group Commander's Certificate, and initiatives serving 2,500+ participants.
							</p>
							<a
								class="text-link"
								href={SOCIAL.linkedin}
								target="_blank"
								rel="noopener"
							>
								LinkedIn <span aria-hidden="true">↗</span>
							</a>
						</div>
					</section>

					<section id="contact" class="portfolio-section contact-note" data-reveal>
						<p>Have a difficult system or a senior engineering role?</p>
						<h2>Tell me what you’re building.</h2>
						<a href="mailto:rajesh-pandey@outlook.in?subject=Engineering%20enquiry">
							rajesh-pandey@outlook.in <span aria-hidden="true">↗</span>
						</a>
					</section>
				</div>
			</div>
		</main>
		<Footer />
		<script>
			const revealItems = document.querySelectorAll('[data-reveal]');
			const primaryReveal = document.querySelector('[data-reveal-sequence]');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!reduceMotion && 'IntersectionObserver' in window) {
				revealItems.forEach((item) => item.classList.add('reveal-ready'));
				window.requestAnimationFrame(() => primaryReveal?.classList.add('is-visible'));
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.12 },
				);
				revealItems.forEach((item) => {
					if (item !== primaryReveal) observer.observe(item);
				});
			}

			const sectionLinks = Array.from(
				document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'),
			);
			const sections = sectionLinks
				.map((link) => {
					const id = link.hash.slice(1);
					const section = document.getElementById(id);
					return section ? { id, link, section } : null;
				})
				.filter((item): item is NonNullable<typeof item> => item !== null);

			const setCurrentSection = (id: string) => {
				sections.forEach((item) => {
					if (item.id === id) {
						item.link.setAttribute('aria-current', 'location');
					} else {
						item.link.removeAttribute('aria-current');
					}
				});
			};

			if ('IntersectionObserver' in window && sections.length > 0) {
				const sectionObserver = new IntersectionObserver(
					(entries) => {
						const current = entries
							.filter((entry) => entry.isIntersecting)
							.sort((a, b) => Math.abs(a.boundingClientRect.top) - Math.abs(b.boundingClientRect.top))[0];

						if (current?.target.id) setCurrentSection(current.target.id);
					},
					{ rootMargin: '-18% 0px -68% 0px', threshold: 0 },
				);

				sections.forEach(({ section }) => sectionObserver.observe(section));
			}
		</script>
	</body>
</html>
