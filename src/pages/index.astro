---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import billingCover from '../assets/billing-migration-cover.png';
import portrait from '../assets/portrait.jpg';
import telehealthCover from '../assets/telehealth-startup-cover.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { homePageGraph } from '../lib/seo';

const homeTitle = `${SITE_TITLE} | ${SITE_TAGLINE} for healthcare platforms`;
const schema = homePageGraph(Astro.site);

const latestPosts = (await getCollection('blog', ({ data }) => data.draft !== true))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={homeTitle}
			description={SITE_DESCRIPTION}
			type="profile"
			preloadFonts={['--font-display', '--font-atkinson']}
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="shell home-hero">
				<div class="home-hero-copy" data-reveal>
					<p class="hero-kicker">Lead Technical Engineer</p>
					<h1>I make healthcare systems dependable.</h1>
					<p class="hero-deck">
						Cloud, backend, mobile, migrations, and the integrations production teams rely on.
					</p>
					<div class="hero-actions">
						<a class="button" href="#impact">View impact</a>
						<a class="button button-secondary" href="/resume.pdf" target="_blank" rel="noopener">
							View résumé
						</a>
					</div>
				</div>
				<figure class="hero-portrait" data-reveal>
					<Image
						src={portrait}
						alt="Rajesh Pandey in a dark suit and tie"
						width={756}
						height={1008}
						widths={[540, 756, 1080]}
						sizes="(max-width: 900px) 100vw, 38vw"
						loading="eager"
					/>
					<figcaption class="hero-caption">
						<span>Rajesh Pandey</span>
						<span>Healthcare platforms</span>
					</figcaption>
				</figure>
			</section>

			<section class="shell proof-strip" aria-label="Career highlights" data-reveal>
				<div class="proof-item">
					<p class="proof-value">8+</p>
					<p class="proof-label">years shipping production software</p>
				</div>
				<div class="proof-item">
					<p class="proof-value">250K+</p>
					<p class="proof-label">Medsi app downloads before acquisition</p>
				</div>
				<div class="proof-item">
					<p class="proof-value">5,000+</p>
					<p class="proof-label">consultations facilitated through Medsi</p>
				</div>
				<div class="proof-item">
					<p class="proof-value">7+</p>
					<p class="proof-label">production systems integrated</p>
				</div>
			</section>

			<section id="impact" class="shell home-section">
				<div data-reveal>
					<h2 class="section-title">Selected outcomes, not just output.</h2>
					<p class="section-intro">
						Work where architecture, delivery, and operational judgment changed the business result.
					</p>
				</div>

				<div class="impact-grid">
					<a
						class="impact-card impact-card-large"
						href="/blog/building-and-selling-a-telehealth-startup/"
						data-reveal
					>
						<div class="impact-media">
							<Image
								src={telehealthCover}
								alt="A modular healthcare network connected to a central coral system"
								width={960}
								height={540}
								widths={[640, 960, 1440]}
								sizes="(max-width: 900px) 100vw, 58vw"
							/>
						</div>
						<div class="impact-copy">
							<p class="impact-context">Medsi</p>
							<h3>Built a telehealth product from zero to acquisition</h3>
							<p>
								Co-founded Medsi and led its backend, API, and mobile infrastructure through
								production scale and a 2024 acquisition by HelloWellness.
							</p>
							<div class="impact-outcome">
								<span>250K+ downloads</span>
								<span>5,000+ consultations</span>
								<span>Acquired in 2024</span>
							</div>
						</div>
					</a>

					<a
						class="impact-card impact-card-small"
						href="/blog/zero-downtime-billing-migrations/"
						data-reveal
					>
						<div class="impact-media">
							<Image
								src={billingCover}
								alt="Two billing systems connected by a continuous coral transfer path"
								width={960}
								height={540}
								widths={[640, 960]}
								sizes="(max-width: 900px) 100vw, 42vw"
							/>
						</div>
						<div class="impact-copy">
							<p class="impact-context">Allia and Brello</p>
							<h3>Moved live subscription billing without interrupting patients</h3>
							<p>
								Planned historical backfills, active-order linking, cohort cutovers, and
								reconciliation for a WooCommerce to Stripe handover.
							</p>
							<div class="impact-outcome">
								<span>Live migration</span>
								<span>Continuous reconciliation</span>
							</div>
						</div>
					</a>

					<article class="impact-card impact-card-wide" data-reveal>
						<div class="impact-copy">
							<p class="impact-context">Real-time data hub</p>
							<h3>Connected the systems behind healthcare delivery</h3>
						</div>
						<div class="impact-copy">
							<p>
								Contributed Cloud Functions and Pub/Sub pipelines connecting WooCommerce,
								Stripe, TelegraMD, MD Integrations, LifeFile, EasyPost, and Intercom. The work
								was designed and operated with the wider data team.
							</p>
							<div class="impact-outcome">
								<span>Event-driven services</span>
								<span>Webhooks and consumers</span>
								<span>7+ integrations</span>
							</div>
						</div>
					</article>
				</div>
			</section>

			<section id="experience" class="shell home-section">
				<div data-reveal>
					<h2 class="section-title">A career shaped by ownership.</h2>
					<p class="section-intro">
						From enterprise systems to a startup acquisition, then into platform leadership across
						a healthcare product group.
					</p>
				</div>

				<div class="experience-list">
					<article class="experience-item" data-reveal>
						<div class="experience-date">2025 to now</div>
						<div>
							<h3 class="experience-role">Lead Technical Engineer</h3>
							<p class="experience-company">Allia Health Group</p>
							<p class="experience-description">
								Lead technical delivery across patient platforms, admin tooling, Brello, and
								provider workflows. Build cloud integration services and guide cross-team work
								from requirements to production.
							</p>
						</div>
					</article>
					<article class="experience-item" data-reveal>
						<div class="experience-date">2024 to 2025</div>
						<div>
							<h3 class="experience-role">Lead Software Engineer and Architect</h3>
							<p class="experience-company">HelloWellness</p>
							<p class="experience-description">
								Led architecture and engineering across backend, mobile, and patient-facing
								systems after HelloWellness acquired Medsi.
							</p>
						</div>
					</article>
					<article class="experience-item" data-reveal>
						<div class="experience-date">Earlier</div>
						<div>
							<h3 class="experience-role">Co-founder and Lead Engineer</h3>
							<p class="experience-company">Medsi</p>
							<p class="experience-description">
								Built the core telehealth platform and its production infrastructure, supporting
								the product through growth and acquisition.
							</p>
						</div>
					</article>
					<article class="experience-item" data-reveal>
						<div class="experience-date">Foundation</div>
						<div>
							<h3 class="experience-role">Software Engineer</h3>
							<p class="experience-company">Tata Consultancy Services</p>
							<p class="experience-description">
								Built an enterprise accounting application from scratch for high-volume
								production workloads and earned TCS Wings 1 recognition.
							</p>
						</div>
					</article>
				</div>
				<a class="text-link" href="/resume.pdf" target="_blank" rel="noopener">
					Full experience in my résumé <span aria-hidden="true">→</span>
				</a>
			</section>

			<section id="expertise" class="shell home-section">
				<div data-reveal>
					<h2 class="section-title">What I am hired to solve.</h2>
					<p class="section-intro">
						Senior engineering work across product boundaries, especially where reliability and
						migration risk matter.
					</p>
				</div>

				<div class="capability-grid">
					<article class="capability" data-reveal>
						<h3>Cloud integrations</h3>
						<p>
							Event-driven services, webhook receivers, downstream consumers, and third-party API
							orchestration on Google Cloud.
						</p>
						<ul aria-label="Cloud integration technologies">
							<li>Cloud Functions</li>
							<li>Cloud Run</li>
							<li>Pub/Sub</li>
							<li>Elasticsearch</li>
						</ul>
					</article>
					<article class="capability" data-reveal>
						<h3>Live migrations</h3>
						<p>
							Billing handovers, historical backfills, active-order linking, reconciliation, and
							cutovers designed around uninterrupted customer experience.
						</p>
						<ul aria-label="Migration technologies">
							<li>Stripe</li>
							<li>WooCommerce</li>
							<li>Idempotency</li>
							<li>Data backfills</li>
						</ul>
					</article>
					<article class="capability" data-reveal>
						<h3>Mobile and backend product</h3>
						<p>
							Features that cross app, API, and delivery boundaries, including subscriptions,
							reminders, push registration, tenant branding, and release workflows.
						</p>
						<ul aria-label="Product engineering technologies">
							<li>TypeScript</li>
							<li>Node.js</li>
							<li>React Native</li>
							<li>CI/CD</li>
						</ul>
					</article>
					<article class="capability" data-reveal>
						<h3>Technical leadership</h3>
						<p>
							Turning ambiguous requirements into maintainable architecture and coordinating
							backend, frontend, mobile, QA, DevOps, and product through delivery.
						</p>
						<ul aria-label="Leadership focus">
							<li>Architecture</li>
							<li>Delivery</li>
							<li>Production reliability</li>
							<li>Mentoring</li>
						</ul>
					</article>
				</div>
			</section>

			<section id="projects" class="shell home-section">
				<div data-reveal>
					<h2 class="section-title">Products I build beyond work.</h2>
				</div>
				<div class="project-list">
					<a class="project" href="https://polygram.dev/" target="_blank" rel="noopener" data-reveal>
						<div>
							<h3>Polygram</h3>
							<p>
								An AI-native coding and design workspace with a VS Code extension, visual
								canvas, and chat-driven development. Built as an individual contributor with
								friends.
							</p>
						</div>
						<div class="project-meta">AI agents / dev tooling / TypeScript</div>
					</a>
					<a
						class="project"
						href="https://chromewebstore.google.com/detail/imageconverter/kpgidifiophnbmnhacklginlcfbbdbld"
						target="_blank"
						rel="noopener"
						data-reveal
					>
						<div>
							<h3>Image Converter</h3>
							<p>
								A privacy-first Chrome extension that converts images locally in the browser.
								Featured on the Chrome Web Store with a 5.0 rating.
							</p>
						</div>
						<div class="project-meta">Chrome extension / offline / utility</div>
					</a>
				</div>
			</section>

			<section id="writing" class="shell home-section">
				<div data-reveal>
					<h2 class="section-title">Writing from production.</h2>
					<p class="section-intro">
						Practical notes on healthcare platforms, subscription migrations, cloud integrations,
						and engineering leadership.
					</p>
				</div>
				<div class="writing-preview">
					{
						latestPosts.map((post) => (
							<a class="writing-card" href={`/blog/${post.id}/`} data-reveal>
								{post.data.heroImage && (
									<div class="writing-card-image">
										<Image
											src={post.data.heroImage}
											alt={post.data.heroImageAlt ?? post.data.title}
											width={960}
											height={540}
											widths={[480, 720, 960]}
											sizes="(max-width: 680px) 100vw, 50vw"
										/>
									</div>
								)}
								<div class="writing-card-copy">
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<div class="writing-meta">
										<FormattedDate date={post.data.pubDate} />
									</div>
								</div>
							</a>
						))
					}
				</div>
				<a class="text-link" href="/blog/">
					Read all articles <span aria-hidden="true">→</span>
				</a>
			</section>

			<section id="about" class="shell home-section">
				<div class="about-panel" data-reveal>
					<div class="about-copy">
						<p>
							I gravitate to the messy parts: migrations, data backfills, billing handovers,
							integration failures, and the production work that earns user trust.
						</p>
					</div>
					<div class="about-details">
						<p>
							I work across backend, frontend, mobile, DevOps, and product. That breadth helps me
							see where responsibilities meet and where systems tend to fail.
						</p>
						<p>
							Beyond engineering, my leadership foundation includes NCC Alpha grade, the Group
							Commander's Certificate, and initiatives that served more than 2,500 participants.
						</p>
						<a class="text-link" href="https://www.linkedin.com/in/rajeshpandey057/" target="_blank" rel="noopener">
							More on LinkedIn <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section id="contact" class="shell home-section">
				<div class="contact-panel" data-reveal>
					<div>
						<h2>Need a senior engineer for a hard system?</h2>
						<p>
							I take on a small number of remote consulting engagements across healthcare
							platforms, cloud integrations, migrations, and developer tooling.
						</p>
					</div>
					<div class="contact-actions">
						<a class="button" href="mailto:rajesh-pandey@outlook.in?subject=Engineering%20enquiry">
							Contact
						</a>
						<a class="button button-secondary" href="/resume.pdf" target="_blank" rel="noopener">
							View résumé
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (reduceMotion || !('IntersectionObserver' in window)) {
				items.forEach((item) => item.classList.add('is-visible'));
			} else {
				items.forEach((item) => item.classList.add('reveal-ready'));
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ threshold: 0.12 },
				);
				items.forEach((item) => observer.observe(item));
			}
		</script>
	</body>
</html>
