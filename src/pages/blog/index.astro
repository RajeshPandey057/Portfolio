---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { blogIndexGraph } from '../../lib/seo';

const BLOG_DESCRIPTION =
	'Practical engineering notes from production: healthcare platforms, subscription migrations, cloud integrations, and technical leadership.';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		...post,
		readingTime: Math.max(1, Math.round((post.body?.trim().split(/\s+/).length ?? 0) / 200)),
	}));

const [featuredPost, ...remainingPosts] = posts;
const schema = blogIndexGraph(
	Astro.site,
	posts.map((post) => ({
		title: post.data.title,
		description: post.data.description,
		path: `/blog/${post.id}/`,
		pubDate: post.data.pubDate,
	})),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Engineering writing | ${SITE_TITLE}`}
			description={BLOG_DESCRIPTION}
			canonicalPath="/blog/"
			preloadFonts={['--font-display', '--font-atkinson']}
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="blog-main">
			<header class="shell blog-hero">
				<h1>Practical notes from production.</h1>
				<p>{BLOG_DESCRIPTION}</p>
				<div class="blog-topics" aria-label="Topics covered">
					<span class="topic-label">Healthcare engineering</span>
					<span class="topic-label">Billing and migrations</span>
					<span class="topic-label">Cloud integrations</span>
					<span class="topic-label">Engineering leadership</span>
				</div>
			</header>

			<section class="shell" aria-label="Published articles">
				{
					!featuredPost ? (
						<div class="empty-state">
							<p>First articles are in progress.</p>
						</div>
					) : (
						<>
							<a class="blog-featured" href={`/blog/${featuredPost.id}/`}>
								{featuredPost.data.heroImage && (
									<div class="blog-featured-media">
										<Image
											src={featuredPost.data.heroImage}
											alt={featuredPost.data.heroImageAlt ?? featuredPost.data.title}
											width={1200}
											height={675}
											widths={[640, 960, 1200, 1600]}
											sizes="(max-width: 900px) 100vw, 62vw"
											loading="eager"
										/>
									</div>
								)}
								<div class="blog-featured-copy">
									<p class="article-topic">{featuredPost.data.tags[0] ?? 'Engineering'}</p>
									<h2>{featuredPost.data.title}</h2>
									<p>{featuredPost.data.description}</p>
									<div class="post-meta">
										<span><FormattedDate date={featuredPost.data.pubDate} /></span>
										<span>{featuredPost.readingTime} min read</span>
									</div>
								</div>
							</a>

							{remainingPosts.length > 0 && (
								<div class="article-list">
									<div class="article-list-header">
										<h2>More articles</h2>
										<a href="/rss.xml">RSS feed</a>
									</div>
									{remainingPosts.map((post) => (
										<article>
											<a class="article-row" href={`/blog/${post.id}/`}>
												{post.data.heroImage && (
													<div class="article-row-image">
														<Image
															src={post.data.heroImage}
															alt={post.data.heroImageAlt ?? post.data.title}
															width={480}
															height={270}
															widths={[320, 480]}
															sizes="12rem"
														/>
													</div>
												)}
												<div>
													<div class="post-meta">
														<span><FormattedDate date={post.data.pubDate} /></span>
														<span>{post.readingTime} min read</span>
													</div>
													<h3>{post.data.title}</h3>
													<p>{post.data.description}</p>
												</div>
												<span class="article-row-arrow" aria-hidden="true">→</span>
											</a>
										</article>
									))}
								</div>
							)}
						</>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
