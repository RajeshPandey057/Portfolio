---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Page not found | ${SITE_TITLE}`}
			description="The page you were looking for could not be found."
			noindex={true}
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="shell not-found">
			<div>
				<p class="not-found-code">Error 404</p>
				<h1>That page moved on.</h1>
				<p>The link may be outdated, but the useful parts of the site are still here.</p>
				<div class="not-found-actions">
					<a class="button" href="/">Go home</a>
					<a class="button button-secondary" href="/blog/">Read the blog</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
