---
import { getImage, Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import portrait from '../assets/portrait-square.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR } from '../consts';
import { blogPostGraph } from '../lib/seo';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type RelatedPost = {
	slug: string;
	title: string;
	description: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	slug: string;
	readingTime: number;
	headings: Heading[];
	relatedPosts: RelatedPost[];
};

const {
	title,
	seoTitle,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	tags = [],
	takeaways = [],
	author = AUTHOR.name,
	slug,
	readingTime,
	headings,
	relatedPosts,
} = Astro.props;

const path = `/blog/${slug}/`;
const ogImage = heroImage
	? new URL(heroImage.src, Astro.site).href
	: new URL('/og.png', Astro.site).href;
const structuredImages = heroImage
	? await Promise.all(
			[
				{ width: 1600, height: 900 },
				{ width: 1200, height: 900 },
				{ width: 1000, height: 1000 },
			].map(async ({ width, height }) => {
				const result = await getImage({
					src: heroImage,
					width,
					height,
					fit: 'cover',
					format: 'webp',
				});
				return new URL(result.src, Astro.site).href;
			}),
		)
	: [ogImage];

const schema = blogPostGraph(Astro.site, {
	title,
	description,
	path,
	pubDate,
	updatedDate,
	image: structuredImages,
	imageAlt: heroImageAlt,
	tags,
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${seoTitle ?? title} | ${AUTHOR.name}`}
			description={description}
			image={heroImage}
			imageAlt={heroImageAlt ?? title}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			tags={tags}
			canonicalPath={path}
			schema={schema}
		/>
	</head>

	<body>
		<Header />
		<main id="main-content" class="article-page">
			<article>
				<header class="shell article-header">
					<nav class="breadcrumb" aria-label="Breadcrumb">
						<a href="/">Home</a>
						<span aria-hidden="true"> / </span>
						<a href="/blog/">Writing</a>
					</nav>
					<h1>{title}</h1>
					<p class="article-deck">{description}</p>
					<div class="post-meta">
						<span>By {author}</span>
						<span>Published <FormattedDate date={pubDate} /></span>
						<span>{readingTime} min read</span>
						{
							updatedDate && (
								<span>
									Updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
				</header>

				{
					heroImage && (
						<figure class="article-hero-image">
							<Image
								src={heroImage}
								alt={heroImageAlt ?? title}
								width={1600}
								height={800}
								widths={[720, 1020, 1440, 1800]}
								sizes="(max-width: 680px) 100vw, 90rem"
								loading="eager"
							/>
						</figure>
					)
				}

				<div class="article-layout">
					<div class="article-body">
						{
							takeaways.length > 0 && (
								<aside class="article-summary" aria-labelledby="takeaways-title">
									<h2 id="takeaways-title">Key takeaways</h2>
									<ul>
										{takeaways.map((takeaway) => <li>{takeaway}</li>)}
									</ul>
								</aside>
							)
						}
						<slot />
					</div>

					<aside class="article-sidebar" aria-label="Article information">
						{
							headings.length > 0 && (
								<div class="article-sidebar-block">
									<p class="article-sidebar-title">In this article</p>
									<nav class="article-toc" aria-label="Table of contents">
										{headings.map((heading) => (
											<a href={`#${heading.slug}`}>{heading.text}</a>
										))}
									</nav>
								</div>
							)
						}
						{
							tags.length > 0 && (
								<div class="article-sidebar-block">
									<p class="article-sidebar-title">Topics</p>
									<ul class="article-tags">
										{tags.map((tag) => (
											<li class="topic-label">{tag}</li>
										))}
									</ul>
								</div>
							)
						}
					</aside>
				</div>

				<section class="article-author" aria-labelledby="author-title">
					<Image
						src={portrait}
						alt="Rajesh Pandey"
						width={128}
						height={128}
						widths={[96, 128, 192]}
						sizes="4rem"
					/>
					<div>
						<h2 id="author-title">Written by Rajesh Pandey</h2>
						<p>
							Lead Technical Engineer building healthcare platforms across cloud, backend,
							mobile, migrations, and production integrations.
						</p>
						<a class="text-link" href="/#about">
							About Rajesh <span aria-hidden="true">→</span>
						</a>
					</div>
				</section>

				{
					relatedPosts.length > 0 && (
						<section class="related-reading" aria-labelledby="related-title">
							<h2 id="related-title">Related reading</h2>
							<div class="related-grid">
								{relatedPosts.map((post) => (
									<a class="related-card" href={`/blog/${post.slug}/`}>
										<h3>{post.title}</h3>
										<p>{post.description}</p>
									</a>
								))}
							</div>
							<a class="text-link" href="/blog/">
								Back to writing <span aria-hidden="true">→</span>
							</a>
						</section>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
